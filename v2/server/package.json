{
  "name": "@battlemap/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "battlemap v2: relay rooms, the built app, files, library, backups and the log forward — Bun.",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target bun --outfile dist/server.js",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test"
  },
  "dependencies": {
    "@battlemap/shared": "workspace:*",
    "mwlog": "file:../../../mwlog-ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^6.0.3"
  }
}
